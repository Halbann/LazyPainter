<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<OutputType>Library</OutputType>
		<RootNamespace>LazyPainter</RootNamespace>
		<AssemblyName>LazyPainter</AssemblyName>
		<TargetFramework>net48</TargetFramework>
		<Version>0.5.0.0</Version>
		<LangVersion>latest</LangVersion>
		<Copyright>Copyright © Halban 2026, CC BY SA</Copyright>
	</PropertyGroup>
	<!-- General -->
	<PropertyGroup>
		<RepoRoot>$(SolutionDir)</RepoRoot>
	</PropertyGroup>
	<!-- KSPBT -->
	<PropertyGroup>
		<KSPBT_ModPluginFolder>Plugins</KSPBT_ModPluginFolder>
		<KSPBT_GenerateDependencyAttributes>false</KSPBT_GenerateDependencyAttributes>
	</PropertyGroup>
	<!-- Publicizer -->
	<ItemGroup>
		<Publicize Include="Assembly-CSharp" />
		<Publicize Include="TexturesUnlimited" />
	</ItemGroup>
	<!-- Mod Dependencies -->
	<ItemGroup>
		<ModReference Include="TexturesUnlimited">
			<DLLPath>GameData/000_TexturesUnlimited/Plugins/TexturesUnlimited.dll</DLLPath>
			<GenerateDependencyAttribute>false</GenerateDependencyAttribute>
			<CKANIdentifier>TexturesUnlimited</CKANIdentifier>
		</ModReference>
	</ItemGroup>
	<!-- Version Files -->
	<ItemGroup>
		<KSPVersionFile Include="LazyPainter.version">
			<Destination>$(KSPBT_ModRoot)/LazyPainter.version</Destination>
		</KSPVersionFile>
	</ItemGroup>
	<!-- Packages -->
	<ItemGroup>
		<PackageReference Include="KSPBuildTools" Version="1.1.1" />
		<PackageReference Include="Krafs.Publicizer" Version="2.3.0">
		  <PrivateAssets>all</PrivateAssets>
		  <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
	</ItemGroup>
	<!-- Copy text files -->
	<Target Name="CopyTextFiles" AfterTargets="Build" BeforeTargets="CopyToGame">
		<Copy SourceFiles="$(RepoRoot)README.md" DestinationFiles="$(KSPBT_ModRoot)Readme.txt" />
		<Copy SourceFiles="$(RepoRoot)LICENSE.md" DestinationFiles="$(KSPBT_ModRoot)License.txt" />
		<Copy SourceFiles="$(RepoRoot)CHANGELOG.md" DestinationFiles="$(KSPBT_ModRoot)Changelog.txt" />
	</Target>
	<!-- Copy mod folder to game -->
	<Target Name="CopyToGame" AfterTargets="Build">
		<ItemGroup>
			<ModFiles Include="$(KSPBT_ModRoot)\**\*" />
		</ItemGroup>
		<Copy SourceFiles="@(ModFiles)" DestinationFiles="@(ModFiles->'$(KSPBT_GameRoot)/GameData/$(MSBuildProjectName)/%(RecursiveDir)%(Filename)%(Extension)')" />
	</Target>
</Project>